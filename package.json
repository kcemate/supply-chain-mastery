{
  "name": "flyway-digital-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build && node scripts/prepare-sites.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "data:refresh-public-footprint": "node scripts/refresh-public-footprint.mjs",
    "data:refresh-verified-locations": "node scripts/refresh-verified-locations.mjs",
    "data:refresh-public-dcs": "node scripts/refresh-public-dc-registry.mjs",
    "data:build-state-atlas": "node scripts/build-state-atlas.mjs",
    "test:engine": "tsx tests/engine.test.ts",
    "test:data": "tsx tests/public-footprint.test.ts",
    "test:evidence": "tsx tests/evidence-domain.test.ts && tsx tests/evidence-refresh.test.ts && tsx tests/evidence-ingestion.test.ts && tsx tests/evidence-workbench.test.tsx && tsx tests/evidence-workbench.browser.ts",
    "test:storage": "tsx tests/workspace-storage.test.ts",
    "test:model-editor": "tsx tests/model-location-panel.test.tsx && tsx tests/model-location-panel.browser.ts",
    "test:platform": "tsx tests/platform.test.ts",
    "test:platform-worker": "tsx tests/platform-worker.test.ts",
    "test:platform:postgres": "tsx tests/platform-postgres.integration.ts",
    "test:browser": "tsx tests/browser-smoke.ts",
    "test:map-overlap": "tsx tests/flyway-map-overlap.browser.ts",
    "test:workspace-context": "tsx tests/workspace-context.browser.ts",
    "test:scenario-draft": "tsx tests/scenario-draft.browser.ts",
    "test:decisions": "tsx tests/decision-intelligence.test.ts && tsx tests/decision-intelligence.test.tsx && tsx tests/decision-intelligence.browser.ts",
    "test:decision-backend": "tsx tests/decision-backend.test.ts",
    "test:intelligence-prototype": "tsx tests/intelligence-prototype.browser.ts",
    "test:intelligence-connected": "tsx tests/intelligence-connected.browser.ts",
    "test:run-artifacts": "tsx tests/run-artifacts.test.ts && tsx tests/run-artifact-decoders.test.ts && tsx tests/run-result-view.test.ts && tsx tests/local-run-repository.browser.ts",
    "test:run-reader": "tsx tests/run-reader.browser.ts",
    "test:platform-national": "tsx tests/platform-national.test.ts",
    "platform:start": "tsx server/cli.ts serve",
    "platform:backup": "tsx server/cli.ts backup",
    "platform:restore": "tsx server/cli.ts restore",
    "design:lint": "designmd lint DESIGN.md",
    "verify": "npm run build && npm run test:engine && npm run test:data && npm run test:evidence && npm run test:storage && npm run test:run-artifacts && npm run test:run-reader && npm run test:model-editor && npm run test:map-overlap && npm run test:workspace-context && npm run test:scenario-draft && npm run test:decisions && npm run test:decision-backend && npm run test:intelligence-prototype && npm run test:intelligence-connected && npm run test:platform && npm run test:platform-worker && npm run test:platform-national && npm run test:browser"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^5.24.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@google/design.md": "^0.2.0",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "topojson-client": "^3.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "us-atlas": "^3.0.1",
    "vite": "^8.2.2"
  }
}
